{
  "schema": "DE.PULSE-CICD-PLAN-2",
  "version": "18.3.0",
  "policy": {
    "light_max_concurrency": 4,
    "medium_max_concurrency": 2,
    "heavy_max_concurrency": 1,
    "evidence_outside_source": true,
    "fingerprint_keyed": true,
    "immutable_rc_for_heavy": true,
    "release_channel": "STABLE",
    "baseline": "v18.2.0 Stable",
    "adaptive_release_learning": true,
    "learning_registry": "release_learning_registry.json",
    "learning_rule": "Adapt owning G0-G16 gate; do not append a new gate for lessons.",
    "roadmap_acceptance_contract": "renderer/qa/original-professional-roadmap-acceptance.json",
    "adaptive_delivery": "one authoritative Markdown handoff + roadmap + next build plan after Stable completion",
    "canonical_release_identity": "release_identity.json",
    "pre_freeze_qualification": true,
    "unique_test_evidence": true,
    "executable_orchestrators": [
      "prefreeze_qualification.py",
      "certification_runner.py"
    ],
    "single_owner_rc": true,
    "artifact_authority": "authoritative_release_index.json + final SHA manifest",
    "major_closure_required_before_major_transition": true,
    "major_closure_profile": "v18.5 Major Closure",
    "major_closure_next_major": "v19",
    "major_transition_requires_explicit_go_no_go": true,
    "major_closure_historical_reports_are_corroboration_only": true,
    "major_closure_requires_senior_engineer_review": true,
    "major_closure_requires_professional_trader_investor_review": true,
    "resource_class_go_heavy_lane": 1,
    "resource_class_medium_other_max_parallel": 2,
    "current_major": "v18",
    "current_slice": "v18.3-postgresql-hosted-shared-state",
    "major_scope": "v18_major_scope.json",
    "delivery_slices": "v18_delivery_slices.json",
    "build_resume_protocol": "adaptive-governance/BUILD_RESUME_PROTOCOL.md",
    "resume_checkpoint": ".depulse-certification/resume/build-checkpoint.json",
    "release_evidence_checkpoint": ".depulse-certification/resume/release-evidence-checkpoint.json",
    "resume_reconciliation_required": true,
    "checkpoint_metadata_excluded_from_product_fingerprint": true,
    "resume_evidence_rule": "Reuse PASS only when branch/release identity and relevant source fingerprint or immutable RC/artifact identity agree; otherwise resume from the earliest affected G0-G16 gate.",
    "checkpoint_cadence": [
      "G3",
      "G4",
      "G10",
      "G11",
      "G12",
      "G14-macos",
      "G14-windows",
      "G15",
      "G16"
    ]
  },
  "stages": [
    {
      "id": "g0_g2",
      "execution": "sequential",
      "resource": "LIGHT",
      "orchestrator": "manual/G0-G2",
      "depends_on": [],
      "resume_rule": "Reconcile active branch, checkpoint, release identity and existing CI evidence before executing new work."
    },
    {
      "id": "development",
      "execution": "parallel-bounded",
      "resource": "MIXED",
      "depends_on": [
        "g0_g2"
      ],
      "rule": "independent workstreams + FAST tests",
      "resume_rule": "Meaningful implementation work is durable only after commit to the active development branch."
    },
    {
      "id": "prefreeze",
      "execution": "parallel-bounded",
      "resource": "LIGHT_MEDIUM",
      "depends_on": [
        "development"
      ],
      "orchestrator": "python3 prefreeze_qualification.py",
      "max_concurrency": {
        "LIGHT": 4,
        "MEDIUM": 2
      },
      "resume_rule": "Evidence is fingerprint-keyed; reuse exact-fingerprint PASS jobs and rerun invalidated/incomplete jobs only."
    },
    {
      "id": "rc_freeze",
      "execution": "sequential",
      "resource": "LIGHT",
      "depends_on": [
        "prefreeze"
      ],
      "rule": "fingerprint immutable candidate",
      "resume_rule": "G11 identity is authoritative for downstream certification; never substitute a mutable development workspace."
    },
    {
      "id": "g12_heavy",
      "execution": "checkpointed-bounded",
      "resource": "HEAVY",
      "depends_on": [
        "rc_freeze"
      ],
      "orchestrator": "python3 certification_runner.py --all",
      "rule": "full Stable matrix; non-blocking BLOCKED residuals record and continue; safe shards may be parallelized only when resource-bounded",
      "resume_rule": "Resume exact-RC completed evidence; source/RC drift invalidates affected downstream evidence."
    },
    {
      "id": "packaging",
      "execution": "parallelizable-from-immutable-rc",
      "resource": "MEDIUM",
      "depends_on": [
        "g12_heavy"
      ],
      "rule": "package outside frozen source",
      "resume_rule": "Track macOS Apple Silicon and Windows x64 package/runtime evidence independently and reuse only exact-source/artifact PASS evidence."
    },
    {
      "id": "authorization",
      "execution": "sequential",
      "resource": "LIGHT",
      "depends_on": [
        "packaging"
      ],
      "rule": "clean extraction -> handoff/evidence -> final independent hashes -> SHA manifest LAST",
      "resume_rule": "Before retrying partial publication, inspect main/tag/release objects independently to prevent duplicate or partial promotion."
    }
  ]
}
