{
  "schema": "DE.PULSE-HOSTED-EXTERNAL-EGRESS-1",
  "version": "v1",
  "owner": "hostedenv",
  "defaultPolicy": "DENY",
  "allowedProtocols": ["https", "wss"],
  "rules": [
    {"host":"api.stlouisfed.org","protocols":["https"],"consumer":"FRED macro/rates","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.federalreserve.gov","protocols":["https"],"consumer":"Federal Reserve official calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.bls.gov","protocols":["https"],"consumer":"BLS official release calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"api.bls.gov","protocols":["https"],"consumer":"BLS official macro API","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"www.bea.gov","protocols":["https"],"consumer":"BEA official release calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"apps.bea.gov","protocols":["https"],"consumer":"BEA official macro API","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"www.census.gov","protocols":["https"],"consumer":"Census official release calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"api.census.gov","protocols":["https"],"consumer":"Census official data API","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"www.dol.gov","protocols":["https"],"consumer":"Department of Labor official release data","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.ismworld.org","protocols":["https"],"consumer":"ISM official release calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.ecb.europa.eu","protocols":["https"],"consumer":"ECB official calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"ec.europa.eu","protocols":["https"],"consumer":"Eurostat/public EU context","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"www.boj.or.jp","protocols":["https"],"consumer":"BOJ official calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.stats.gov.cn","protocols":["https"],"consumer":"China NBS official calendar/context","sourcePaths":["macro_events.go"],"runtimeAllowed":true},
    {"host":"www.pbc.gov.cn","protocols":["http"],"consumer":"PBOC official calendar","sourcePaths":["macro_events.go"],"runtimeAllowed":false,"blockReason":"legacy plaintext source URL must migrate to HTTPS before hosted egress is authorized"},
    {"host":"api.eia.gov","protocols":["https"],"consumer":"EIA official energy data","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"home.treasury.gov","protocols":["https"],"consumer":"U.S. Treasury official rates","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"api.fiscaldata.treasury.gov","protocols":["https"],"consumer":"U.S. Treasury fiscal-data API","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"query1.finance.yahoo.com","protocols":["https"],"consumer":"yfinance-style recovery-only market context","sourcePaths":["fallback_providers.go","global_market_providers.go"],"runtimeAllowed":true},
    {"host":"query2.finance.yahoo.com","protocols":["https"],"consumer":"Yahoo recovery endpoint","sourcePaths":["fallback_providers.go"],"runtimeAllowed":true},
    {"host":"api.twelvedata.com","protocols":["https"],"consumer":"Twelve Data equity/global/VIX/history","sourcePaths":["fallback_providers.go","global_market_providers.go"],"runtimeAllowed":true},
    {"host":"cdn.cboe.com","protocols":["https"],"consumer":"Cboe official VIX history","sourcePaths":["global_market_providers.go"],"runtimeAllowed":true},
    {"host":"finnhub.io","protocols":["https"],"consumer":"Finnhub REST market/research data","sourcePaths":["quote_providers.go","research_providers.go"],"runtimeAllowed":true},
    {"host":"ws.finnhub.io","protocols":["wss"],"consumer":"Finnhub live equities websocket","sourcePaths":["runtime_live_loop.go"],"runtimeAllowed":true},
    {"host":"api.alpaca.markets","protocols":["https"],"consumer":"Alpaca trading/calendar/assets/options REST","sourcePaths":["symbol_universe.go","market_activity_corporate.go","options_intelligence.go"],"runtimeAllowed":true},
    {"host":"paper-api.alpaca.markets","protocols":["https"],"consumer":"Alpaca asset-universe same-provider fallback","sourcePaths":["symbol_universe.go"],"runtimeAllowed":true},
    {"host":"data.alpaca.markets","protocols":["https"],"consumer":"Alpaca market-data snapshots/history/options","sourcePaths":["quote_providers.go","history_providers.go","market_activity_corporate.go","options_intelligence.go"],"runtimeAllowed":true},
    {"host":"stream.data.alpaca.markets","protocols":["wss"],"consumer":"Alpaca IEX live websocket","sourcePaths":["runtime_live_loop.go"],"runtimeAllowed":true},
    {"host":"api.marketaux.com","protocols":["https"],"consumer":"Marketaux news fallback","sourcePaths":["research_providers.go"],"runtimeAllowed":true},
    {"host":"www.sec.gov","protocols":["https"],"consumer":"SEC/EDGAR filings, ticker map and archive links","sourcePaths":["sec_intelligence.go"],"runtimeAllowed":true},
    {"host":"data.sec.gov","protocols":["https"],"consumer":"SEC submissions/company facts","sourcePaths":["sec_intelligence.go"],"runtimeAllowed":true},
    {"host":"api.tradeinsight.info","protocols":["https"],"consumer":"TradeInsight historical/corporate/congressional intelligence","sourcePaths":["tradeinsight.go","tradeinsight_congress.go","tradeinsight_congress_probe.go"],"runtimeAllowed":true},
    {"host":"api.groq.com","protocols":["https"],"consumer":"Groq AI second-opinion route","sourcePaths":["ai_clients.go"],"runtimeAllowed":true},
    {"host":"openrouter.ai","protocols":["https"],"consumer":"OpenRouter AI second-opinion route","sourcePaths":["ai_clients.go"],"runtimeAllowed":true},
    {"host":"generativelanguage.googleapis.com","protocols":["https"],"consumer":"Google Gemini AI second-opinion route","sourcePaths":["ai_clients.go"],"runtimeAllowed":true},
    {"host":"api.telegram.org","protocols":["https"],"consumer":"development community-intelligence Telegram integration","sourcePaths":["community_intelligence_api.go"],"runtimeAllowed":true}
  ]
}
